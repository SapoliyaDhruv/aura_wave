<?xml version="1.0" encoding="utf-8"?>
<!-- The YouTube Music login (and the sign-in page's cookies) never leaves this phone, by backup or by transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="downloads" />
        <exclude domain="file" path="feed.json" />
        <exclude domain="sharedpref" path="account.xml" />
        <exclude domain="file" path="account_remote_likes.txt" />
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="feed.json" />
        <exclude domain="sharedpref" path="account.xml" />
        <exclude domain="file" path="account_remote_likes.txt" />
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
