<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens the bottom of the cover widget, so the song's name reads over any cover. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="#0014101B"
        android:centerY="0.5"
        android:endColor="#0014101B"
        android:startColor="#F214101B"
        android:type="linear" />
    <corners android:radius="20dp" />
</shape>
