<?xml version="1.0" encoding="utf-8"?>
<!-- The recently played widget: one row of four covers; taller, the covers grow. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_recent_description"
    android:initialLayout="@layout/widget_recent"
    android:minWidth="250dp"
    android:minHeight="56dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="56dp"
    android:previewLayout="@layout/widget_recent"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
